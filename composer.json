{
    "name": "cortexpe/commando",
    "description": "A command framework virion for Axolotl-PM",
    "type": "library",
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "AxolotlBucketLabs"
        },
        {
            "name": "CortexPE",
            "homepage": "https://CortexPE.xyz"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/SimplePacketHandler",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {"CortexPE\\Commando\\": ["src/CortexPE/Commando/"]}
    },
    "require": {
        "php": "^8.4",
        "muqsit/simple-packet-handler": "^0.1.10"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.51.2",
        "phpstan/phpstan": "^2.3"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress"
    },
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "CortexPE\\Commando"
        }
    }
}
